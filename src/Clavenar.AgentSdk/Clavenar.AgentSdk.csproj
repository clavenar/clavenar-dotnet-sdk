<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>

    <PackageId>Clavenar.AgentSdk</PackageId>
    <Version>1.4.0</Version>
    <Authors>VanteguardLabs</Authors>
    <Description>Wrap your Anthropic / OpenAI client. Every tool call is inspected by Clavenar before it runs.</Description>
    <PackageProjectUrl>https://clavenar.com</PackageProjectUrl>
    <RepositoryUrl>https://github.com/clavenar/clavenar-dotnet-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>clavenar;ai-security;mcp;anthropic;openai;tool-use;policy;audit</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
    <None Include="../../fixtures/sdk-cross-language-v1.fixture.json" Pack="true" PackagePath="fixtures/" />
    <None Include="../../fixtures/retry-separation-v1.fixture.json" Pack="true" PackagePath="fixtures/" />
    <None Include="../../fixtures/retry-separation-v1.schema.json" Pack="true" PackagePath="fixtures/" />
    <InternalsVisibleTo Include="Clavenar.AgentSdk.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Release'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
